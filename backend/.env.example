PORT=5000
NODE_ENV=development

# JWT
# Leave blank: a random secret is generated on first start and stored in backend/.jwt_secret
# (next to the database), so sessions survive restarts. Example values such as
# "<your-secure-random-secret-here>" or "your-secret-key-change-in-production" are public
# knowledge and are ignored. To set your own:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=7d

# API Keys
GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# Scraper Settings
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
SCRAPER_DELAY=2000
SCRAPER_MAX_RETRIES=3

# Monitoring
# MONITOR_CHECK_INTERVAL=5 */6 * * *   (optional override; default staggers jobs)

# Auto-search wanted books (every 2 hours)
# SEARCH_INTERVAL=20 */2 * * *        (optional override)

# Client URL
CLIENT_URL=http://localhost:3000

# Optional fallbacks for settings normally set in the UI (Settings > Sources / Text-to-Speech)
# FLARESOLVERR_URL=http://localhost:8191
# ANNAS_ARCHIVE_DOMAINS=annas-archive.gl,annas-archive.pk,annas-archive.gd
# SEARXNG_URL=http://localhost:8888
# TTS_OPENAI_BASE_URL=http://localhost:8880/v1

# Re-point book files whose stored path no longer resolves (renamed share, different
# drive letter, machine switched off). Pairs of <stored root>=<current root>, separated
# by ';', applied in order; the stored path is used when it still exists.
# LIBRARY_PATH_REMAP=\\nas\ebooks=D:\ebooks;\\old-pc\h\Calibre=D:\Calibre

# Re-point paths reported by download clients at the paths this machine can read
# (container paths like /data/downloads, or the same share seen from another host).
# Pairs of <client path>=<path here>, separated by ';'. Only needed when the client
# and Bookarr disagree: the common "release name is not the file name" and missing
# category folder cases are handled automatically.
# DOWNLOAD_PATH_REMAP=/data/downloads=D:\Downloads;/downloads=\\nas\complete

