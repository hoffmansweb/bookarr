# Bookarr Docker Configuration
# Copy to .env next to docker-compose.yml:  cp .env.docker .env

# Your GitHub username (for pulling the image from ghcr.io)
GITHUB_USER=your-github-username

# Host port for the web UI
BOOKARR_PORT=5000
TZ=America/Chicago

# Run as your host user so files written to the library are owned by you, not root.
# Find them with:  id -u  /  id -g
# Leave unset (or 0) for root - required if the mounted folders are only writable by root.
PUID=
PGID=

# Security
# Leave blank: a random secret is generated on first start and kept in the data volume.
JWT_SECRET=
# Required by SearXNG; generate with:  openssl rand -hex 32
SEARXNG_SECRET=

# Optional: local Kokoro-FastAPI / openedai-speech server (OpenAI-compatible TTS).
# Blank uses the bundled Edge TTS voices, which need no extra setup.
KOKORO_URL=

# API Keys (optional)
GOOGLE_BOOKS_API_KEY=

# Host paths mounted into the container. Library layout inside:
#   /library/ebooks/<Author>/...       /library/audiobooks/<Author>/<Title>/...
# (defaults for the ebooks/audiobooks/download folder settings; change them in Settings if needed)
DOWNLOAD_DIR=/path/to/your/downloads
LIBRARY_DIR=/path/to/your/books

# Auto-update check interval in seconds (default: 300 = 5 minutes)
UPDATE_INTERVAL=300
